#!/bin/sh
# Install the hakopodOS state layout and GRUB settings on the OEM partition.
# Called from the after-install and after-reset hooks, and once more at boot
# as a fallback.
set -eu
src=/usr/lib/hakopod-os/oem/91_hakopod-layout.yaml
name=$(basename "$src")

if mountpoint -q /oem; then
  oem=/oem
else
  dev=$(blkid -L COS_OEM 2>/dev/null) || { echo "hakopod-os: no COS_OEM partition" >&2; exit 0; }
  oem=$(mktemp -d /run/hakopod-os-oem.XXXXXX)
  mount "$dev" "$oem"
  trap 'umount "$oem"; rmdir "$oem"' EXIT
fi

if ! cmp -s "$src" "$oem/$name"; then
  install -m 0644 "$src" "$oem/$name"
  echo "hakopod-os: installed $name on the OEM partition; it applies from the next boot"
fi

# GRUB timeout. The Kairos grub.cfg on COS_STATE opens with "set timeout=10"
# and then loads the first /grub_oem_env that "search --file" finds, which
# is the copy on COS_STATE itself, not the one on OEM. Set it there; COS_STATE
# is only writable from the install, reset and upgrade hooks, so at runtime,
# when it is mounted read-only, this part is skipped.
editenv=$(command -v grub2-editenv || command -v grub-editenv || true)
state_dev=$(blkid -L COS_STATE 2>/dev/null || true)
if [ -n "$editenv" ] && [ -n "$state_dev" ] && ! findmnt -rn -S "$state_dev" -O ro >/dev/null; then
  state=$(mktemp -d /run/hakopod-os-state.XXXXXX)
  mount "$state_dev" "$state"
  if [ "$("$editenv" "$state/grub_oem_env" list 2>/dev/null | sed -n 's/^timeout=//p')" != 1 ]; then
    "$editenv" "$state/grub_oem_env" set timeout=1
    echo "hakopod-os: GRUB timeout set to 1 s"
  fi
  umount "$state"; rmdir "$state"
fi
